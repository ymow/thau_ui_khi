{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "jsx": "react-native",
    "target": "esnext",
    "module": "esnext",
    "lib": ["esnext"]
  },
  "include": [
    "src/**/*",
    "App.tsx",
    "app.config.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
